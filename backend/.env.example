# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Groq AI configuration. Add one or more keys; the backend will use them in
# round-robin order and fail over on transient errors.
GROQ_KEY_1="your-groq-api-key"
# GROQ_KEY_2="optional-second-groq-api-key"
# Override only with a model available to this Groq account.
GROQ_MODEL="openai/gpt-oss-120b"

# Sandbox GST API Key
SANDBOX_API_KEY="your-sandbox-api-key"
